# Minecraft Server - Variables de Entorno
# Copia este archivo a .env y configura tus valores

# === Recursos ===
# Local: 4G, GCP e2-standard-4: 10G
MEMORY=4G

# === Seguridad ===
# Tu nombre de usuario de Minecraft (serás OP/admin)
OPS_PLAYER=TuNombreDeUsuario

# Whitelist: true para producción, false para local
WHITELIST=false

# Contraseña RCON (usada por watchdog para detectar jugadores)
RCON_PASSWORD=cambiar_esta_password

# === Mundo ===
# Seed del mundo (dejar vacío para aleatorio)
WORLD_SEED=
