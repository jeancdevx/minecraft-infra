# Minecraft Server - Variables de Entorno
# Copia este archivo a .env y edita los valores

# ========================================
# RECURSOS
# ========================================

# RAM para el servidor
# Local: 4G, Cloud: 10G
MEMORY=4G

# ========================================
# ADMINISTRACIÓN
# ========================================

# Tu nombre de usuario de Minecraft (serás OP/admin)
OPS_PLAYER=TuNombreDeUsuario

# Activar lista blanca (true/false)
# true = solo jugadores aprobados pueden entrar
WHITELIST=false

# ========================================
# SEGURIDAD
# ========================================

# Contraseña RCON (para comandos remotos)
# Cambiar por una segura en producción
RCON_PASSWORD=cambiar_esta_password

# ========================================
# MUNDO
# ========================================

# Seed del mundo (dejar vacío para aleatorio)
# Ejemplo: WORLD_SEED=1234567890
WORLD_SEED=
